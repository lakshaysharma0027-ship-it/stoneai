{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "DATABASE_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SUPABASE_PROJECT_REF",
    "SUPABASE_SERVICE_ROLE_KEY",
    "AWS_BEDROCK_API_KEY",
    "AWS_BEARER_TOKEN_BEDROCK",
    "BEDROCK_CLAUDE_MODEL",
    "AWS_REGION",
    "DODO_API_KEY",
    "DODO_PAYMENTS_API_KEY",
    "DODO_ENVIRONMENT",
    "DODO_PRODUCT_FREE_TRIAL",
    "DODO_PRODUCT_BASIC",
    "DODO_PRODUCT_BASIC_PLUS",
    "DODO_PRODUCT_PRO",
    "DODO_PRODUCT_PREMIUM",
    "DODO_WEBHOOK_SECRET",
    "DODO_PAYMENTS_WEBHOOK_KEY",
    "GOOGLE_API_KEY",
    "GEMINI_API_KEY",
    "GEMINI_GENERATION_ENABLED",
    "GOOGLE_NANO_BANANA_MODEL",
    "GOOGLE_VEO_MODEL",
    "STONEAI_ADMIN_EMAILS",
    "NEXT_PUBLIC_STONEAI_ROOT_DOMAIN",
    "NEXT_PUBLIC_STONEAI_APP_HOST",
    "NEXT_PUBLIC_STONEAI_APP_HOSTS",
    "NEXT_PUBLIC_STONEAI_CUSTOM_DOMAIN_TARGET"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
